# genviewer 접속 설정.  genviewer.env 로 복사해서 값을 채운다.
#
#   cp genviewer.env.example genviewer.env
#   vi genviewer.env
#   chgrp <팀그룹> genviewer.env && chmod 640 genviewer.env
#
# 이 파일을 배포 디렉터리에 두면 팀원은 자기 홈에 아무것도 만들지 않아도 그냥
# 실행하면 붙는다. 개인 값을 쓰려면 ~/.genviewer.env 에 같은 형식으로 둔다.
# 무엇이 읽혔는지는 `genviewer --check-config` 로 확인한다.
#
# chmod 640 은 권장이 아니다. PGPASSWORD 가 든 파일을 아무나 읽을 수 있으면
# 앱이 실행을 거부한다. 팀 그룹만 읽는다는 전제로 쓰는 파일이다.
# **절대 커밋하지 않는다** (.gitignore 에 들어 있다).
#
# 형식 규칙은 일부러 적다:
#   - 주석은 줄 전체만. 값 뒤의 # 는 값의 일부다 (비밀번호에 # 가 흔해서).
#   - $FOO 치환 없음, 여러 줄 값 없음.
#   - 앞뒤 공백을 살리려면 값을 따옴표로 감싼다.
#
# 키 이름은 libpq 그대로다. 여기 없는 것도 그대로 넘어간다
# (PGSSLMODE, PGCONNECT_TIMEOUT, PGOPTIONS 등).

PGHOST=10.1.2.3
PGPORT=55433
PGDATABASE=molgen
PGUSER=molgen_app
PGPASSWORD=

# 이미 ~/.pg_service.conf 를 쓴다면 위를 지우고 이 한 줄로 대신할 수 있다.
# PGSERVICE=molgen

# 서버에 TLS 인증서를 설정한 뒤에만 켠다. 안 켠 상태에서 넣으면 접속이 끊긴다.
# 기본값 prefer 는 TLS 가 안 되면 조용히 평문으로 내려간다.
# PGSSLMODE=verify-full
